{
  "name": "pi-workbench",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.23.2",
    "pnpm": "11.25.0"
  },
  "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956",
  "scripts": {
    "format": "biome format --write .",
    "format:staged": "node --experimental-strip-types packages/tooling/src/format-staged.ts check",
    "install:format-hook": "node --experimental-strip-types packages/tooling/src/format-staged.ts install",
    "test:format-hook": "pnpm build && WORKBENCH_EXERCISE_FORMAT_HOOK=1 node --test packages/tooling/dist/tests/format-staged.test.js",
    "format:check": "biome check .",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm build && pnpm -r run test",
    "check:toolchain": "node packages/tooling/dist/src/toolchain.js",
    "check:hooks": "node packages/tooling/dist/src/hooks.js",
    "test:hooks": "node packages/tooling/dist/src/hooks.js --exercise",
    "check:commits": "node packages/tooling/dist/src/commits.js",
    "audit": "pnpm audit --audit-level high",
    "outdated": "pnpm -r outdated",
    "registry:plan": "node packages/tooling/dist/src/registry.js",
    "bundle:inventory": "node packages/tooling/dist/src/bundle-inventory.js inventory",
    "bundle:verify": "node packages/tooling/dist/src/bundle-inventory.js verify",
    "check:sources": "node --experimental-strip-types packages/tooling/src/sources.ts",
    "check:dependencies": "node packages/tooling/dist/src/dependencies.js",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm check:toolchain && pnpm check:dependencies"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@earendil-works/pi-coding-agent": "0.85.0",
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "22.20.1",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "typescript": "7.0.2"
  }
}
