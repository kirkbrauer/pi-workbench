# Trusted toolchain image ONLY, not the untrusted-worker VM boundary.
FROM docker.io/library/node@sha256:4d676821dff059fd00d277ee4261ef34ea712317fed0737c03941481b5760c96
ENV COREPACK_HOME=/opt/corepack
RUN corepack enable pnpm && mkdir -p /opt/corepack /workspace && chown node:node /opt/corepack /workspace
WORKDIR /workspace
COPY --chown=node:node . /workspace
USER node
RUN corepack install \
    && node --experimental-strip-types packages/tooling/src/sources.ts \
    && pnpm install --frozen-lockfile --ignore-scripts \
    && pnpm check \
    && rm -rf .local/pnpm-store
# Checks need writable compiler output, never a writable host checkout.
CMD ["sh", "-eu", "-c", "cp -a /workspace /tmp/workspace; cd /tmp/workspace; pnpm check"]
